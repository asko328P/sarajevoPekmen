    "@supabase/supabase-js": "^2.45.6",
    "expo": "^52.0.0",
    "expo-constants": "~17.0.7",
    "expo-dev-client": "~5.0.12",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "expo-web-browser": "~14.0.2",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
